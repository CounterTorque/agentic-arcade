{
  "name": "agentic-arcade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:full": "TEST_DEPTH=full vitest run",
    "test:e2e": "playwright test",
    "test:e2e:full": "TEST_DEPTH=full playwright test",
    "check:games": "node scripts/check-games.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "new:game": "node scripts/new-game.mjs",
    "verify:game": "node scripts/verify-game.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:games && npm test && npm run build && npm run check:budget",
    "verify:full": "npm run lint && npm run typecheck && npm run check:games && npm run test:full && npm run build && npm run check:budget && npm run test:e2e:full"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
